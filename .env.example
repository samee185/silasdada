# Copy this file to .env and fill it in. Never commit .env to Git.

NODE_ENV=development
PORT=3000
# The address people use to open the site (no trailing slash)
APP_URL=http://localhost:5173

# MySQL connection — on Hostinger: hPanel → Databases → MySQL Databases
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/silasdada

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# One-time code for creating Rev'd Dada's account at /admin/claim.
# Set it, create the account, then delete this value and restart.
SETUP_TOKEN=

# ── Stage 3: email and reminders (leave empty for now) ──
CRON_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rev'd Silas O. Dada <appointments@silasdada.com.ng>"

# ── Stage 5: AI drafts (Gemini free tier, leave empty for now) ──
# Free key: https://aistudio.google.com → Get API key. Sermon text only is ever sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
